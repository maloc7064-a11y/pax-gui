-- MÜZİK BUTONLARI FONKSİYONU
local function createMusicBtn(name, id, pitch, x, y)
	local btn = Instance.new("TextButton")
	btn.Parent = scrollingFrame
	btn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	btn.BorderColor3 = Color3.fromRGB(255, 105, 180)
	btn.BorderSizePixel = 1
	btn.Position = UDim2.new(0, x, 0, y)
	btn.Size = UDim2.new(0, 130, 0, 40)
	btn.Font = Enum.Font.SourceSans
	btn.Text = name
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextSize = 15
	btn.TextWrapped = true

	btn.MouseButton1Click:Connect(function()
		local hdAdmin = replicatedStorage:FindFirstChild("HDAdminClient") or replicatedStorage:FindFirstChild("HDAdminHDClient")
		if hdAdmin and hdAdmin:FindFirstChild("Signals") and hdAdmin.Signals:FindFirstChild("RequestCommand") then
			hdAdmin.Signals.RequestCommand:InvokeServer(";music " .. tostring(id))
			if pitch then
				hdAdmin.Signals.RequestCommand:InvokeServer(";pitch " .. tostring(pitch))
			end
			hdAdmin.Signals.RequestCommand:InvokeServer(";volume inf")
		end
	end)
end

